# 운영 서버 값. 이 파일을 같은 폴더의 .env로 복사해 채운다(cp .env.example .env). .env는 커밋하지 않는다.
# 따옴표나 export 없이 이름=값으로만 쓰고, 값에는 공백·#·\·$·따옴표를 넣지 않는다.

# 서버 주소(예: DuckDNS 서브도메인). HTTPS 인증서도 이 이름으로 받는다
DOMAIN=

# 운영 MySQL 계정. 비밀번호는 openssl rand -hex 16 으로 만든다.
# MySQL은 데이터 볼륨을 처음 만들 때만 이 값으로 계정을 만든다 — 나중에 바꾸려면 DB를 지워야 하니 처음 값을 그대로 쓴다
DB_USERNAME=mwt
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 내 컴퓨터의 값을 옮기지 말고 새로 만든다: JWT_SECRET은 openssl rand -hex 32, STAFF_CODE는 openssl rand -hex 8
JWT_SECRET=
STAFF_CODE=

# 솔라피(확정 문자). 셋 다 비우면 문자를 보내지 않고 서버 로그로만 남긴다.
# 솔라피 콘솔에서 이 API Key의 허용 IP에 서버 고정 IP를 더해야 문자가 나간다
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# OpenAI(음성으로 고르기). 비우면 음성 API만 503을 돌려준다
OPENAI_API_KEY=
