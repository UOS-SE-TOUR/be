# 공식 nginx 이미지가 시작할 때 이 파일의 ${DOMAIN}을 .env 값으로 채워 /etc/nginx/conf.d/default.conf로 만든다

server_tokens off;

server {
    listen 80;
    server_name ${DOMAIN};

    # 인증서 갱신 때 Let's Encrypt가 확인하는 파일(certbot 컨테이너가 쓴다). 이것만 HTTP로 내준다
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker 내장 DNS로 서버 컨테이너 주소를 그때그때 찾는다. 다시 배포해 서버 컨테이너의 주소가 바뀌어도
    # Nginx를 다시 띄우지 않아도 되고, 서버가 아직 안 떠 있어도 Nginx는 뜬다
    resolver 127.0.0.11 valid=10s;
    set $tour_server http://app:8080;

    # 서버 API와 API 문서. 주소 뒤에 경로를 붙이지 않아 /api로 시작하는 경로를 떼지 않고 그대로 넘긴다(README 화면과 연결)
    location /api/ {
        proxy_pass $tour_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 서버가 멈춰 있거나(다시 배포 중) 응답이 늦을 때도 API 오류 모양({"message"})으로 돌려준다.
        # 서버가 직접 돌려준 503(음성 API 키 없음 등)은 그대로 지나간다(proxy_intercept_errors가 꺼져 있다)
        error_page 502 503 = @tour_server_unavailable;
        error_page 504 = @tour_server_timeout;
    }

    location @tour_server_unavailable {
        default_type application/json;
        return 503 '{"message":"서버에 잠시 연결할 수 없습니다. 잠시 뒤 다시 시도해 주세요."}';
    }

    # 응답이 60초(proxy_read_timeout 기본값)를 넘겨 끊은 요청은 서버가 이미 처리했을 수 있어, 바로 다시 보내라고 하지 않는다
    location @tour_server_timeout {
        default_type application/json;
        return 504 '{"message":"서버 응답이 늦어 처리됐는지 알 수 없습니다. 결과를 확인한 뒤 다시 시도해 주세요."}';
    }

    # 화면은 정적 호스팅에 따로 있으므로 이 서버는 /api만 받는다
    location / {
        return 404;
    }
}
